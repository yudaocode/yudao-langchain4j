<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-agentic-a2a</artifactId>
    <name>LangChain4j :: Agentic Framework :: A2A Integration</name>

    <developers>
        <developer>
            <id>mariofusco</id>
            <email>mario.fusco@gmail.com</email>
            <url>https://github.com/mariofusco</url>
        </developer>
    </developers>

    <properties>
        <agentscope-a2a-sdk.version>2.1.0-jdk8-SNAPSHOT</agentscope-a2a-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>2.1.1</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.15.0</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.52.0</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.36.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.iocoder.agentscope</groupId>
            <artifactId>agentscope-a2a-sdk-java8</artifactId>
            <version>${agentscope-a2a-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-agentic</artifactId>
            <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-test</artifactId>
            <version>${langchain4j.beta.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Javadoc reads the generated sources before bytecode is lowered to Java 8. -->
                    <release>17</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
