<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.25.0-beta35-jdk8-SNAPSHOT</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-hibernate-milvus</artifactId>
    <name>LangChain4j :: Hibernate 5 :: Milvus Entity Store</name>

    <properties>
        <hibernate.version>5.6.15.Final</hibernate.version>
        <milvus-sdk-java.version>2.6.27</milvus-sdk-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging</artifactId>
                <version>3.4.3.Final</version>
            </dependency>

            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.52.0</version>
            </dependency>
            <!-- milvus-sdk-java brings protobuf-java transitively at 3.25.5/3.25.8; pin to converge -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.25.9</version>
            </dependency>
            <!-- milvus-sdk-java brings org.jetbrains:annotations at 17.0.0 and via kotlin-stdlib at 13.0; pin to converge (23.0.0, as resolved before) -->
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>23.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-hibernate</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>${milvus-sdk-java.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.1</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>java8-main-sources</id>
                        <configuration>
                            <arguments combine.self="override">
                                <argument>--source</argument>
                                <argument>17</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>${maven.multiModuleProjectDirectory}/compatibility/java8/Java8SourceGenerator.java</argument>
                                <argument>${project.basedir}/src/main/java8</argument>
                                <argument>${project.build.directory}/generated-sources/java8</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>java8-test-sources</id>
                        <configuration>
                            <arguments combine.self="override">
                                <argument>--source</argument>
                                <argument>17</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>${maven.multiModuleProjectDirectory}/compatibility/java8/Java8SourceGenerator.java</argument>
                                <argument>${project.basedir}/src/test/java8</argument>
                                <argument>${project.build.directory}/generated-test-sources/java8</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
