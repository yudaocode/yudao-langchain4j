<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>
    <artifactId>langchain4j-mcp</artifactId>
    <name>LangChain4j :: Integration :: Model Context Protocol</name>
    <properties>
        <!-- Large-message tests must exercise limits rather than dump megabytes of wire logs. -->
        <compat.test.log.level>info</compat.test.log.level>
    </properties>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
        </dependency>
        <!-- test dependencies -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-test</artifactId>
            <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.24.0-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client-okhttp</artifactId>
            <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client-apache</artifactId>
            <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.6.0</version>
            <!-- Java-WebSocket 1.6 uses only the SLF4J 1.7 binary API; retain Boot 2 logging. -->
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- OkHttp and Apache are only on the test classpath for their MCP ITs; everything else keeps using the JDK client -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration combine.children="append">
                    <systemPropertyVariables>
                        <tinylog.level>${compat.test.log.level}</tinylog.level>
                        <langchain4j.http.clientBuilderFactory>dev.langchain4j.http.client.jdk.JdkHttpClientBuilderFactory</langchain4j.http.clientBuilderFactory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration combine.children="append">
                    <systemPropertyVariables>
                        <tinylog.level>${compat.test.log.level}</tinylog.level>
                        <langchain4j.http.clientBuilderFactory>dev.langchain4j.http.client.jdk.JdkHttpClientBuilderFactory</langchain4j.http.clientBuilderFactory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Runs this module's existing tests with langchain4j-core-jackson3 on the test classpath,
            so the JSON SPI resolves to the Jackson 3 codec instead of the Jackson 2 default.
            Jackson 2 is still present - this checks that the DTOs are readable by both codecs,
            which is what the opt-in promises.
        -->
        <profile>
            <id>jackson3</id>
            <dependencies>
                <dependency>
                    <groupId>cn.iocoder.langchain4j</groupId>
                    <artifactId>langchain4j-core-jackson3</artifactId>
                    <version>1.24.0-beta34-jdk8-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
