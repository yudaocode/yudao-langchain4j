<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.25.0-beta35-jdk8-SNAPSHOT</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>
    <artifactId>langchain4j-anthropic</artifactId>
    <version>1.25.0-jdk8-SNAPSHOT</version>
    <name>LangChain4j :: Integration :: Anthropic</name>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-reactive-streaming</artifactId>
            <version>1.25.0-beta35-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-mutiny-zero-compat</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- test dependencies -->
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Shared reactive non-blocking TCK (AbstractChatModelNonBlockingIT) -->
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-reactive-streaming</artifactId>
            <version>1.25.0-beta35-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Reactive non-blocking TCK: AnthropicStreamingChatModelPublisherNonBlockingIT uses BlockHound -->
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>1.25.0-jdk8-SNAPSHOT</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>me.kpavlov.aimocks</groupId>
            <artifactId>ai-mocks-anthropic-jvm</artifactId>
            <version>${ai-mocks.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runs the TestNG-based Reactive Streams TCK (PublisherVerification) under the JUnit Platform -->
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration combine.children="append">
                    <!-- The shared non-blocking chat-model TCK runs BlockHound, which needs this flag to instrument
                         JDK classes on JDK 13+. Keep the parent's argLine and the mockito agent. -->
                    <argLine>@{argLine} -XX:+AllowRedefinitionToAddDeleteMethods</argLine>
                    <jvm>${compat.fixture.test.jvm}</jvm>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <jvm>${compat.fixture.test.jvm}</jvm>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Runs this module's existing tests with langchain4j-core-jackson3 on the test classpath,
            so the JSON SPI resolves to the Jackson 3 codec instead of the Jackson 2 default.
            Jackson 2 is still present - this checks that the DTOs are readable by both codecs,
            which is what the opt-in promises.
        -->
        <profile>
            <id>jackson3</id>
            <dependencies>
                <dependency>
                    <groupId>cn.iocoder.langchain4j</groupId>
                    <artifactId>langchain4j-core-jackson3</artifactId>
                    <version>1.25.0-beta35-jdk8-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <properties>
        <compat.fixture.test.jvm>${java.home}/bin/java</compat.fixture.test.jvm>
    </properties>
</project>
