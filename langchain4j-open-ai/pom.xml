<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.25.0-beta35-preview-20261120</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-open-ai</artifactId>
    <version>1.25.0-preview-20261120</version>
    <name>LangChain4j :: Integration :: OpenAI</name>

    <dependencies>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.25.0-preview-20261120</version>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.25.0-preview-20261120</version>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-reactive-streaming</artifactId>
            <version>1.25.0-beta35-preview-20261120</version>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <version>1.25.0-preview-20261120</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>${jtokkit.version}</version>
        </dependency>

        <dependency>
            <groupId>io.smallrye.reactive</groupId>
            <artifactId>mutiny-zero</artifactId>
        </dependency>


        <!-- test dependencies -->

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>1.25.0-preview-20261120</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-http-client</artifactId>
            <version>1.25.0-preview-20261120</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Shared reactive non-blocking TCK (AbstractChatModelNonBlockingIT) -->
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-reactive-streaming</artifactId>
            <version>1.25.0-beta35-preview-20261120</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>me.kpavlov.aimocks</groupId>
            <artifactId>ai-mocks-openai-jvm</artifactId>
            <version>${ai-mocks.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Runs the TestNG-based Reactive Streams TCK (PublisherVerification) under the JUnit Platform -->
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration combine.children="append">
                    <!-- Keep the parent's argLine and append the flag BlockHound needs to
                         instrument JDK classes on JDK 13+. Benign for tests that don't use
                         BlockHound. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -XX:+AllowRedefinitionToAddDeleteMethods</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration combine.children="append">
                    <!-- OpenAiStreamingChatModelNonBlockingIT runs BlockHound, which needs this
                         flag to instrument JDK classes on JDK 13+. Keep the parent's argLine and
                         the mockito agent. Benign for ITs that don't use BlockHound. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -XX:+AllowRedefinitionToAddDeleteMethods</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Runs this module's existing tests with langchain4j-core-jackson3 on the test classpath,
            so the JSON SPI resolves to the Jackson 3 codec instead of the Jackson 2 default.
            Jackson 2 is still present - this checks that the DTOs are readable by both codecs,
            which is what the opt-in promises.
        -->
        <profile>
            <id>jackson3</id>
            <dependencies>
                <dependency>
                    <groupId>cn.iocoder.langchain4j</groupId>
                    <artifactId>langchain4j-core-jackson3</artifactId>
                    <version>${langchain4j.beta.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

