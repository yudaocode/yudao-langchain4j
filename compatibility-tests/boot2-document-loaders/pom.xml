<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath />
    </parent>
    <groupId>cn.iocoder.langchain4j.compatibility</groupId>
    <artifactId>boot2-document-loaders</artifactId>
    <version>1.25.0-jdk8-SNAPSHOT</version>
    <properties>
        <java.version>8</java.version>
        <httpclient5.version>5.6.5</httpclient5.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <logback.version>1.2.13</logback.version>
        <maven.compiler.release>8</maven.compiler.release>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
        <maven.deploy.skip>true</maven.deploy.skip>
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <jakarta-json.version>2.1.3</jakarta-json.version>
        <jakarta-json-bind.version>2.0.0</jakarta-json-bind.version>
        <yasson.version>2.0.2</yasson.version>
        <netty.version>4.1.140.Final</netty.version>
        <selenium.version>4.13.0</selenium.version>
        <gson.version>2.14.0</gson.version>
        <okhttp.version>4.12.1</okhttp.version>
        <kotlin.version>2.2.21</kotlin.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>1.25.0-jdk8-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>3.7.19</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-core</artifactId>
                <version>1.2.18</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-http</artifactId>
                <version>1.2.18</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.6.0-jre</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-amazon-s3</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-google-cloud-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-playwright</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-selenium</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-document-loader-tencent-cos</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <testIncludes>
                        <testInclude>**/Java8*IT.java</testInclude>
                        <testInclude>**/LocalAzureBlobStorageDocumentLoaderIT.java</testInclude>
                        <testInclude>**/Native8DependencyFallbackTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <jvm>${compat.test.jvm}</jvm>
                    <includes>
                        <include>**/Java8*IT.java</include>
                        <include>**/LocalAzureBlobStorageDocumentLoaderIT.java</include>
                        <include>**/Native8DependencyFallbackTest.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>actual-sdk-fixtures</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-amazon-s3/src/test/java</source>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-azure-storage-blob/src/test/java</source>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-google-cloud-storage/src/test/java</source>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-playwright/src/test/java</source>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-selenium/src/test/java</source>
                                <source>${project.basedir}/../../document-loaders/langchain4j-document-loader-tencent-cos/src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>