<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iocoder.langchain4j</groupId>
        <artifactId>langchain4j-parent</artifactId>
        <version>1.25.0-beta35-preview-20261120</version>
        <relativePath>../langchain4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>langchain4j-bom</artifactId>
    <version>1.25.0-preview-20261120</version>
    <packaging>pom</packaging>

    <name>LangChain4j :: BOM</name>
    <description>Bill of Materials POM for getting full, complete set of compatible versions of LangChain4j modules</description>

    <properties>
        <langchain4j.stable.version>1.25.0-preview-20261120</langchain4j.stable.version>
        <langchain4j.beta.version>1.25.0-beta35-preview-20261120</langchain4j.beta.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-core</artifactId>
                <version>${langchain4j.stable.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.stable.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-reactive-streaming</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-http-client</artifactId>
                <version>${langchain4j.stable.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-http-client-jdk</artifactId>
                <version>${langchain4j.stable.version}</version>
            </dependency>

            <!-- model providers -->

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.stable.version}</version>
            </dependency>

            <!-- embedding stores -->

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-infinispan</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-mcp</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            <!-- embeddings -->

            <!-- code execution engines -->

            <!-- document loaders -->

            <!-- document parsers -->

            <!-- document transformers -->

            <!-- embedding store filter parsers -->

            <!-- web searchers -->
            <!-- experimental -->
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-skills</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            <!-- observability -->
            <!-- spring boot 3 -->
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-spring-boot-starter</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            <!-- spring boot 4 -->
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-spring-boot4-starter</artifactId>
                <version>${langchain4j.beta.version}</version>
            </dependency>

            </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <properties>keep</properties>
                        <distributionManagement>remove</distributionManagement>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                        <phase>process-resources</phase>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

