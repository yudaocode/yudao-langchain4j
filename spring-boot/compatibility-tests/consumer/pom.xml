<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cn.iocoder.langchain4j.compatibility</groupId>
    <artifactId>modern-spring-starter-consumer</artifactId>
    <version>1.24.0</version>
    <properties>
        <boot.version>3.5.15</boot.version>
        <starter.artifactId>langchain4j-spring-boot-starter</starter.artifactId>
        <openai.starter.artifactId>langchain4j-open-ai-spring-boot-starter</openai.starter.artifactId>
        <openai.transport.artifactId>langchain4j-http-client-spring-restclient</openai.transport.artifactId>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <compat.test.jvm>${java.home}/bin/java</compat.test.jvm>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>1.25.0-preview-20261120</version>
            </dependency>
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-core</artifactId>
                <version>1.25.0-preview-20261120</version>
            </dependency>
            <dependency>
                <groupId>cn.iocoder.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>1.25.0-preview-20261120</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>${starter.artifactId}</artifactId>
            <version>1.25.0-beta35-preview-20261120</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>${openai.starter.artifactId}</artifactId>
            <version>1.24.0-beta34</version>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>${openai.transport.artifactId}</artifactId>
            <version>1.24.0-beta34</version>
            <exclusions>
                <exclusion>
                    <groupId>dev.langchain4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <jvm>${compat.test.jvm}</jvm>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
